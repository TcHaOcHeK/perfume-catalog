# Адрес Apache (OpenServer/XAMPP), где лежит папка perfume-catalog
VITE_PROXY_TARGET=http://localhost:8080
# Во время разработки запросы идут на /api (его проксирует Vite)
VITE_API_URL=/api
# Откуда брать картинки товаров
VITE_ASSETS_URL=/perfume-catalog/assets
# В dev админка (localhost:5173) и сайт (localhost:8080) — разные origin, localStorage не общий,
# поэтому используем встроенную Vue-страницу /login (оставляем пустым)
VITE_LOGIN_URL=
