# API .htaccess — запросы к несуществующим файлам уходят в index.php.
# CORS настраивается в PHP (api/index.php): здесь заголовки Access-Control-* не выставляем,
# иначе «*» перекроет список разрешённых адресов.
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [QSA,L]

# Служебные PHP-файлы напрямую не открываются, только через index.php
<IfModule mod_authz_core.c>
    <FilesMatch "^(jwt|resources)\.php$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
